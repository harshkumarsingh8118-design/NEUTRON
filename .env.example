# NEUTRON AI Server Environment Variables
PORT=3001

# Authentication (required for sign in and sign up)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/neutron?retryWrites=true&w=majority
MONGODB_DATABASE=neutron
# Generate a long random secret, e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Deployed frontend URL, e.g. https://neutron.onrender.com
CLIENT_ORIGIN=

# NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Security and Workspace Boundaries
WORKSPACE_DIR=./workspace_sandbox
COMMAND_TIMEOUT_MS=25000
