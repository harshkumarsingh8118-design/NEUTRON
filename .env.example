# NEUTRON AI Server Environment Variables
PORT=3001

# AI Model Provider API Keys (Optional: Leave blank to use NEUTRON Built-in Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Default Configuration
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# Security and Workspace Boundaries
WORKSPACE_DIR=./workspace_sandbox
COMMAND_TIMEOUT_MS=25000
