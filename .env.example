# NEUTRON AI Server Environment Variables
PORT=3001

# NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Other AI Model Provider API Keys (Optional: Leave blank to use NVIDIA or Built-in Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Default Configuration
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Security and Workspace Boundaries
WORKSPACE_DIR=./workspace_sandbox
COMMAND_TIMEOUT_MS=25000
